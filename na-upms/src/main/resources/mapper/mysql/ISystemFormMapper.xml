<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.na.core.mapper.ISystemFormMapper">

    <select id="queryPaging" resultType="com.na.entity.SystemFormEntity">
        select * from system_form
        <where>
            <if test="params.fromCode != null">
                and `code` = #{params.fromCode}
            </if>
        </where>
    </select>

</mapper>
