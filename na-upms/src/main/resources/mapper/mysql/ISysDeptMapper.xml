<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.na.core.mapper.ISysDeptMapper">

    <select id="queryAll" resultType="com.na.entity.SysDeptEntity">
        SELECT * FROM sys_dept
        WHERE is_del = 0
    </select>

    <!-- 查重刻意不过滤 is_del：唯一性由应用层保证，已删除的部门名不允许重建 -->
    <select id="queryByName" resultType="com.na.entity.SysDeptEntity">
        SELECT * FROM sys_dept
        WHERE name = #{name}
        LIMIT 1
    </select>

    <select id="queryByParentId" resultType="com.na.entity.SysDeptEntity">
        SELECT * FROM sys_dept
        WHERE parent_id = #{parentId}
        AND is_del = 0
    </select>

</mapper>
