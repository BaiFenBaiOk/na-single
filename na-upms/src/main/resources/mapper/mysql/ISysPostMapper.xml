<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.na.core.mapper.ISysPostMapper">

    <select id="queryPaging" resultType="com.na.entity.SysPostEntity">
        SELECT * FROM sys_post
        <where>
            <if test="params.name != null and params.name != ''">
                and name like concat('%',#{params.name},'%')
            </if>
            <if test="params.code != null and params.code != ''">
                and code like concat('%',#{params.code},'%')
            </if>
            <if test="params.isDel != null">
                and is_del = #{params.isDel}
            </if>
        </where>
        order by create_time desc
    </select>

    <!-- 查重刻意不过滤 is_del：唯一索引不含 is_del，过滤会导致撞索引 500 -->
    <select id="queryByCode" resultType="com.na.entity.SysPostEntity">
        SELECT * FROM sys_post
        WHERE code = #{code}
        LIMIT 1
    </select>

    <!-- 名称查重同样不过滤 is_del -->
    <select id="queryByName" resultType="com.na.entity.SysPostEntity">
        SELECT * FROM sys_post
        WHERE name = #{name}
        LIMIT 1
    </select>

    <!-- 调用方须保证 ids 非空（空集合会生成 IN () 语法错误） -->
    <select id="queryByIds" resultType="com.na.entity.SysPostEntity">
        SELECT * FROM sys_post
        WHERE is_del = 0
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
