### Logs ###
*.log

# 排除根目录的 work 和 xxl-job 目录
/work/
/xxl-job/
# 忽略整个xxl‑job文件夹
xxl-job/

# 如果是单个文件（不是文件夹）
xxl-job
# 只忽略仓库根目录下的 logs 文件夹（子模块中的 logs 不受影响）
/logs/
/ai-model/
/doc/nacos_config_export*.zip

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*
.codex/

# AOCI 根目录生成的索引文件（本地工具产物，不入库）
/aoci*.txt

# ==================== 前端工程 web/ ====================
# 规则统一在本文件管理（web/.gitignore 已移除）；源码必须入库（AOCI 扫描依赖 git 忽略权威），
# 此处只忽略依赖、构建产物与自动生成文件
node_modules/
web/dist/
web/dist-ssr/
web/.vite/
*.local
web/*.tsbuildinfo
web/src/types/auto-imports.d.ts
web/src/types/components.d.ts

# 前端包管理调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== 通用忽略 ====================
# 本地备份 / 临时文件
*.bak
*.tmp
*.swp

# 测试与覆盖率
coverage/
.nyc_output/

# 系统文件
Thumbs.db
Desktop.ini

# 本地环境变量（.env.development / .env.production 是项目模板，需入库）
.env.local
.env.*.local
